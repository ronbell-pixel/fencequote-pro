// Cloudflare Worker configuration for FenceQuote Pro.
// Replace every REPLACE_ME value before deploying — see DEPLOY.md.
// Secret (not stored here): SUPER_ADMIN_EMAILS — set with `npx wrangler secret put SUPER_ADMIN_EMAILS`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fencequote-pro",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Your Cloudflare account ID (or set CLOUDFLARE_ACCOUNT_ID instead).
  // "account_id": "REPLACE_ME",

  "observability": { "enabled": true },

  // Served at the custom domain; Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "fencepro.nextwin-os.com", "custom_domain": true }],
  // The app refuses requests without an Access token anyway; this keeps the only entrance behind Access.
  "workers_dev": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fencequote-db",
      // Printed by: npx wrangler d1 create fencequote-db
      "database_id": "55bd1e8e-94c8-4301-be9c-681655b958ff"
    }
  ],

  "r2_buckets": [
    {
      "binding": "UPLOADS",
      // Create with: npx wrangler r2 bucket create fencequote-uploads
      "bucket_name": "fencequote-uploads"
    }
  ],

  "vars": {
    // Cloudflare Access: Zero Trust → Settings → Custom pages shows your team domain,
    // and the Access application's Overview tab shows its Application Audience (AUD) tag.
    "CF_ACCESS_TEAM_DOMAIN": "more-ron.cloudflareaccess.com",
    "CF_ACCESS_AUD": "516c021a7d0226fdc78fc85f16f732ea94d5a2f84874214c943fca2579091691",

    // Name of the first company created when a platform admin signs in to an empty database.
    "BOOTSTRAP_COMPANY_NAME": "My Fence Company",

    // Never "true" in production: fills an empty database with demo companies.
    "SEED_DEMO_DATA": "false"
  }
}
